    private void btnLoginActionPerformed(java.awt.event.ActionEvent evt) {                                         
       String username = txtUsername.getText().trim();
    String password = new String(txtPassword.getPassword());

    // =========================
    // VALIDATE USERNAME
    // =========================
    if (username.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "You need to put your Username!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // VALIDATE PASSWORD
    // =========================
    if (password.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "You need to put your Password!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // Registration allows 8-12 characters
    if (password.length() < 8 || password.length() > 12) {
        JOptionPane.showMessageDialog(this,
                "Password must be 8-12 characters!",
                "Invalid Password",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // VALIDATE ROLE
    // =========================
    String selectedRole = "";

    if (rbtnAdmin.isSelected()) {
        selectedRole = "Admin";
    } else if (rbtnSeller.isSelected()) {
        selectedRole = "Seller";
    } else if (rbtnUser.isSelected()) {
        selectedRole = "User";
    } else {
        JOptionPane.showMessageDialog(this,
                "Please select your role!",
                "Role Required",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // GET SAVED ACCOUNT
    // =========================
    String savedPassword = Register.accounts.get(username);
    String savedRole = Register.userRoles.get(username);

    // =========================
    // CHECK ACCOUNT
    // =========================
    if (savedPassword == null || savedRole == null) {

        JOptionPane.showMessageDialog(this,
                "Account not found!\nPlease register an account first.",
                "Login Failed",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // CHECK PASSWORD
    // =========================
    if (!savedPassword.equals(password)) {

        JOptionPane.showMessageDialog(this,
                "Incorrect username or password!",
                "Login Failed",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // CHECK ROLE
    // =========================
    if (!savedRole.equals(selectedRole)) {

        JOptionPane.showMessageDialog(this,
                "The selected role does not match your registered account role!",
                "Login Failed",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    if (savedPassword.equals(password)
        && savedRole.equals(selectedRole)) {

    String loginTime = new java.text.SimpleDateFormat(
            "yyyy-MM-dd HH:mm:ss"
    ).format(new java.util.Date());

    Login.loginHistory.add(new String[] {
        username,
        savedRole,
        loginTime
    });

    JOptionPane.showMessageDialog(this,
            "Login successful!",
            "Success",
            JOptionPane.INFORMATION_MESSAGE);
    }
    // =========================
    // ADMIN LOGIN
    // =========================
    if ("Admin".equals(savedRole)) {

        JOptionPane.showMessageDialog(this,
                "Admin Login Successful!",
                "Success",
                JOptionPane.INFORMATION_MESSAGE);

        admin adminForm = new admin();
        adminForm.setVisible(true);

        dispose();
    }

    // =========================
    // SELLER LOGIN
    // =========================
    else if ("Seller".equals(savedRole)) {

        JOptionPane.showMessageDialog(this,
                "Seller Login Successful!",
                "Success",
                JOptionPane.INFORMATION_MESSAGE);

        seller sellerForm = new seller();
        sellerForm.setVisible(true);

        dispose();
    }

    // =========================
    // USER LOGIN
    // =========================
    else if ("User".equals(savedRole)) {

        JOptionPane.showMessageDialog(this,
                "User Login Successful!",
                "Success",
                JOptionPane.INFORMATION_MESSAGE);

        user userForm = new user();
        userForm.setVisible(true);

        dispose();
    }

      
    }                                        

