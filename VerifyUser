    private void loadUsers() {
    javax.swing.table.DefaultTableModel model =
            (javax.swing.table.DefaultTableModel) Username.getModel();

    // Clear the default empty rows
    Username.setModel(new javax.swing.table.DefaultTableModel(
    new Object [][] {},
    new String [] {
        "Username", "Status"
    }
));
for (String username : Register.accounts.keySet()) {

        String role = Register.userRoles.get(username);

        // Show the username and role/status
        model.addRow(new Object[]{
            username,
            role
        });
    

    Username.setModel(model);
    jScrollPane1.setViewportView(Username);
}



