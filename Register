    private void btnClearActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        
        
        String username = txtUsername.getText();
    String password = txtPassword.getText();
   
    String answer = txtAnswer.getText();

          
    
 if (username.isEmpty() && password.isEmpty() && answer.isEmpty()
        && !rbtnAdmin.isSelected() && !rbtnSeller.isSelected() && !rbtnUser.isSelected()) {

        JOptionPane.showMessageDialog(this,
            "There is nothing to clear!",
            "Error",
            JOptionPane.ERROR_MESSAGE);
        return;
    }
 txtUsername.setText("");
    txtPassword.setText("");
   
    txtAnswer.setText("");
    // Optional: reset radio buttons
    rbtnAdmin.setSelected(false);
    rbtnSeller.setSelected(false);
    rbtnUser.setSelected(false);
    

    // Optional: reset combo box
    jComboBox1.setSelectedIndex(0);

    JOptionPane.showMessageDialog(this, "Form cleared!");

    }                                        

    private void btnSaveActionPerformed(java.awt.event.ActionEvent evt) {                                        
        // TODO add your handling code here:
        
      

   String username = txtUsername.getText().trim();
    String password = new String(txtPassword.getPassword());
    String answer = txtAnswer.getText().trim().toLowerCase();
    String question = jComboBox1.getSelectedItem().toString();

    String role;

    // =========================
    // USERNAME VALIDATION
    // =========================
    if (username.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "You must put Username first!!!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // PASSWORD VALIDATION
    // =========================
    if (password.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "You must put a Password first!!!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // Password must be 8-12 characters
    if (password.length() < 8 || password.length() > 12) {
        JOptionPane.showMessageDialog(this,
                "Password must be 8-12 characters!",
                "Invalid Password",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // SECURITY ANSWER
    // =========================
    if (answer.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "Security answer is required!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // ROLE VALIDATION
    // =========================
    if (rbtnAdmin.isSelected()) {
        role = "Admin";
    } else if (rbtnSeller.isSelected()) {
        role = "Seller";
    } else if (rbtnUser.isSelected()) {
        role = "User";
    } else {
        JOptionPane.showMessageDialog(this,
                "Please select a role!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // SECURITY QUESTION
    // =========================
    if (!question.equals("What is your favorite color?")
            && !question.equals("What is your favorite food?")
            && !question.equals("What is your favorite movie?")) {

        JOptionPane.showMessageDialog(this,
                "Invalid security question selected!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // BLOCKED WORDS
    // =========================
    String[] blockedWords = {
        "fuck", "shit", "bitch", "ass", "damn",
        "sex", "porn", "nude", "naked",
        "tite", "burat", "tanginamo", "bobo"
    };

    for (String word : blockedWords) {
        if (answer.contains(word)) {
            JOptionPane.showMessageDialog(this,
                    "Your answer contains inappropriate words!",
                    "Invalid Input",
                    JOptionPane.ERROR_MESSAGE);
            return;
        }
    }

    // =========================
    // DUPLICATE USERNAME
    // =========================
    if (accounts.containsKey(username)) {
        JOptionPane.showMessageDialog(this,
                "This username already exists! Try another one.",
                "Account Exists",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // DUPLICATE PASSWORD
    // =========================
    if (accounts.containsValue(password)) {
        JOptionPane.showMessageDialog(this,
                "This password is already used! Choose another password.",
                "Account Exists",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // ONLY ONE ADMIN
    // =========================
    if (role.equals("Admin") && adminExists) {
        JOptionPane.showMessageDialog(this,
                "Admin account already exists! You cannot create another Admin.",
                "Access Denied",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // =========================
    // SAVE ACCOUNT
    // =========================
    accounts.put(username, password);
    userRoles.put(username, role);

    // Remember that Admin already exists
    if (role.equals("Admin")) {
        adminExists = true;
    }

    // Account has now been successfully saved
    accountSaved = true;

    JOptionPane.showMessageDialog(this,
            "Account successfully created!\n"
            + "Username: " + username + "\n"
            + "Role: " + role,
            "Success",
            JOptionPane.INFORMATION_MESSAGE);

    }                                       

