    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        String username = txtUsername.getText().trim();
    String answer = txtAnswer.getText().trim().toLowerCase();
    String newPassword = txtPassword.getText().trim();

    // Check username
    if (username.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "Please enter your username.",
                "Missing Information",
                JOptionPane.WARNING_MESSAGE);
        txtUsername.requestFocus();
        return;
    }

    // Check if username exists
    if (!Register.accounts.containsKey(username)) {
        JOptionPane.showMessageDialog(this,
                "Username does not exist.",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        txtUsername.requestFocus();
        return;
    }

    // Check answer
    if (answer.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "Please enter your security answer.",
                "Missing Information",
                JOptionPane.WARNING_MESSAGE);
        txtAnswer.requestFocus();
        return;
    }

    // Check if security answer exists
    if (!Register.securityAnswers.containsKey(username)) {
        JOptionPane.showMessageDialog(this,
                "No security question was found for this account.",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

    // Verify security answer
    String correctAnswer =
            Register.securityAnswers.get(username);

    if (!answer.equalsIgnoreCase(correctAnswer)) {
        JOptionPane.showMessageDialog(this,
                "Incorrect security answer.",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        txtAnswer.requestFocus();
        return;
    }

    // Check new password
    if (newPassword.isEmpty()) {
        JOptionPane.showMessageDialog(this,
                "Please enter a new password.",
                "Missing Information",
                JOptionPane.WARNING_MESSAGE);
        txtPassword.requestFocus();
        return;
    }
    if (newPassword.length() < 8 || newPassword.length() > 12) { JOptionPane.showMessageDialog(this, "Password must be 8-12 characters!", "Invalid Password", JOptionPane.ERROR_MESSAGE); return; } // Make sure new password is different 
    String oldPassword = Register.accounts.get(username); if (newPassword.equals(oldPassword)) { JOptionPane.showMessageDialog(this, "New password must be different from your old password!", "Invalid Password", JOptionPane.ERROR_MESSAGE); return; } // SAVE NEW PASSWORD 
    Register.accounts.put(username, newPassword); JOptionPane.showMessageDialog(this, "Password successfully changed!\n" + "You can now login using your new password.", "Success", JOptionPane.INFORMATION_MESSAGE);
    
    

    // Password length
    if (newPassword.length() < 8 || newPassword.length() > 12) {
        JOptionPane.showMessageDialog(this,
                "Password must be 8 to 12 characters long.",
                "Invalid Password",
                JOptionPane.WARNING_MESSAGE);
        txtPassword.requestFocus();
        return;
    }

    // Check blocked words
    String lowerPassword = newPassword.toLowerCase();

    String[] blockedWords = {
        "fuck", "shit", "bitch", "damn",
        "sex", "porn", "nude", "naked",
        "tite", "burat", "tanginamo", "bobo"
    };

    for (String word : blockedWords) {
        if (lowerPassword.contains(word)) {
            JOptionPane.showMessageDialog(this,
                    "The new password contains an inappropriate word.",
                    "Invalid Password",
                    JOptionPane.WARNING_MESSAGE);
            txtPassword.requestFocus();
            return;
        }
    }

    // Check if new password is the same as the old password
    

     Login lg = new Login();
    lg.setVisible(true);
    dispose();

    }                                        

